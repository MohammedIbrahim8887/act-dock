{
  "name": "act-dock",
  "version": "0.1.1",
  "description": "Local GitHub Actions runner for desktop and AI agents",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  },
  "scripts": {
    "dev": "hutch run dev:hmr",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test",
    "build:ui": "vite build",
    "build:runner": "bun scripts/build-runner.ts",
    "cli": "bun src/cli/index.ts",
    "build": "hutch run build:canary",
    "build:brand": "bun scripts/build-brand.ts stable",
    "installer:mac": "bun scripts/macos/package.ts stable",
    "verify:installer": "uv run --with dmgbuild==1.6.7 python scripts/macos/verify-dmg.py artifacts/macos-arm64-ActDock.dmg"
  }
}
