{
  "name": "act-dock-workspace",
  "private": true,
  "version": "0.2.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "dev:desktop": "cd apps/desktop && bun run dev",
    "typecheck": "bun run --filter \"@act-dock/*\" typecheck && tsc --noEmit -p tsconfig.tools.json",
    "test": "bun test apps/desktop/tests ./tests",
    "build:web": "cd apps/web && bun run build",
    "build:desktop": "cd apps/desktop && bun run build",
    "check": "bun run typecheck && bun run test && bun run --filter @act-dock/desktop build:ui && bun run build:web",
    "release": "bun scripts/release.ts",
    "deploy": "cd apps/web && bun run deploy",
    "cli": "bun apps/desktop/src/cli/index.ts",
    "prepare:desktop": "bun scripts/prepare.ts",
    "ci:local": "bun scripts/run-ci.ts",
    "install:release-runner": "bun scripts/install-release-runner.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "~5.9.3"
  }
}
