index 0000000..acd8eab
--- /dev/null
+++ b/pkg/runner/readiness.go
@@ -0,0 +1,81 @@
+package runner
+
+import (
+	"context"
+	"fmt"
+	"github.com/nektos/act/pkg/common"
+	"github.com/nektos/act/pkg/model"
+)
+
+// newReadinessExecutor removes plan-wide stage barriers without splitting a
+// job's matrix or cleanup. Completion is published only after its executor
+// returns, establishing visibility of outputs before a dependent starts.
+func newReadinessExecutor(plan *model.Plan, parallel int, makeExecutor func(*model.Run) common.Executor) common.Executor {
+	return func(ctx context.Context) error {
+		type key struct {
+			workflow *model.Workflow
+			id       string
+		}
+		type result struct {
+			key key
+			err error
+		}
+		pending := make([]*model.Run, 0)
+		known := map[key]bool{}
+		for _, stage := range plan.Stages {
+			for _, run := range stage.Runs {
+				k := key{run.Workflow, run.JobID}
+				if !known[k] {
+					known[k] = true
+					pending = append(pending, run)
+				}
+			}
+		}
+		completed := map[key]bool{}
+		results := make(chan result, len(pending))
+		if parallel < 1 {
+			parallel = 1
+		}
+		active := 0
+		var firstErr error
+		for len(pending) > 0 || active > 0 {
+			for i := 0; i < len(pending) && active < parallel && firstErr == nil; {
+				run := pending[i]
+				ready := true
+				for _, need := range run.Job().Needs() {
+					k := key{run.Workflow, need}
+					if known[k] && !completed[k] {
+						ready = false
+						break
+					}
+				}
+				if !ready {
+					i++
+					continue
+				}
+				pending = append(pending[:i], pending[i+1:]...)
+				active++
+				go func(run *model.Run) { results <- result{key{run.Workflow, run.JobID}, makeExecutor(run)(ctx)} }(run)
+			}
+			if active == 0 {
+				if firstErr != nil {
+					return firstErr
+				}
+				if len(pending) > 0 {
+					return fmt.Errorf("workflow dependency graph contains unsatisfied jobs")
+				}
+				break
+			}
+			result := <-results
+			active--
+			completed[result.key] = true
+			if result.err != nil && firstErr == nil {
+				firstErr = result.err
+			}
+		}
+		if firstErr != nil {
+			return firstErr
+		}
+		return ctx.Err()
+	}
+}
