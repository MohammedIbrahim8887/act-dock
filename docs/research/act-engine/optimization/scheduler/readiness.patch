+++ b/pkg/runner/readiness_test.go
@@ -0,0 +1,108 @@
+package runner
+
+import (
+	"context"
+	"errors"
+	"github.com/nektos/act/pkg/common"
+	"github.com/nektos/act/pkg/model"
+	"gopkg.in/yaml.v3"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func readinessFixture(t *testing.T) *model.Plan {
+	t.Helper()
+	var w model.Workflow
+	if err := yaml.Unmarshal([]byte(`name: asymmetric
+jobs:
+  fast: {runs-on: ubuntu-latest, steps: [{run: 'true'}]}
+  slow: {runs-on: ubuntu-latest, steps: [{run: 'true'}]}
+  child: {needs: fast, runs-on: ubuntu-latest, steps: [{run: 'true'}]}
+`), &w); err != nil {
+		t.Fatal(err)
+	}
+	return &model.Plan{Stages: []*model.Stage{{Runs: []*model.Run{{Workflow: &w, JobID: "fast"}, {Workflow: &w, JobID: "slow"}}}, {Runs: []*model.Run{{Workflow: &w, JobID: "child"}}}}}
+}
+func TestReadinessStartsEligibleChild(t *testing.T) {
+	plan := readinessFixture(t)
+	child := make(chan struct{})
+	slow := make(chan struct{})
+	finished := make(chan error, 1)
+	go func() {
+		finished <- newReadinessExecutor(plan, 2, func(run *model.Run) common.Executor {
+			return func(context.Context) error {
+				switch run.JobID {
+				case "slow":
+					<-slow
+				case "child":
+					close(child)
+				}
+				return nil
+			}
+		})(context.Background())
+	}()
+	select {
+	case <-child:
+	case <-time.After(time.Second):
+		close(slow)
+		t.Fatal("child waited for unrelated slow job")
+	}
+	close(slow)
+	if err := <-finished; err != nil {
+		t.Fatal(err)
+	}
+}
+func TestReadinessRespectsLimitAndOutputVisibility(t *testing.T) {
+	plan := readinessFixture(t)
+	var active, peak atomic.Int32
+	var output string
+	err := newReadinessExecutor(plan, 1, func(run *model.Run) common.Executor {
+		return func(context.Context) error {
+			n := active.Add(1)
+			if n > peak.Load() {
+				peak.Store(n)
+			}
+			defer active.Add(-1)
+			switch run.JobID {
+			case "fast":
+				output = "visible"
+			case "child":
+				if output != "visible" {
+					t.Error("dependency output unavailable")
+				}
+			}
+			return nil
+		}
+	})(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if peak.Load() != 1 {
+		t.Fatal("concurrency limit exceeded")
+	}
+}
+func TestReadinessWaitsForCleanupAfterError(t *testing.T) {
+	plan := readinessFixture(t)
+	cleaned := make(chan struct{})
+	err := newReadinessExecutor(plan, 2, func(run *model.Run) common.Executor {
+		return func(context.Context) error {
+			if run.JobID == "fast" {
+				return errors.New("fatal")
+			}
+			if run.JobID == "slow" {
+				time.Sleep(time.Millisecond)
+				close(cleaned)
+			}
+			return nil
+		}
+	})(context.Background())
+	if err == nil {
+		t.Fatal("lost error")
+	}
+	select {
+	case <-cleaned:
+	default:
+		t.Fatal("returned before cleanup")
+	}
+}
